rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============ 輔助函數 ============

    // 檢查是否已登入
    function isSignedIn() {
      return request.auth != null;
    }

    // 取得用戶資料（使用 get 函數）
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 檢查是否有權管理特定班級
    function isClassAdminOf(classId) {
      let userData = getUserData();
      return isSignedIn() && (
        userData.role == 'owner' ||
        (userData.role == 'classAdmin' && userData.classId == classId)
      );
    }

    // ============ 用戶資料 ============
    // 注意：此路徑的規則不能呼叫 isOwner() 或 getUserData()，否則會造成遞迴
    match /users/{userId} {
      // 用戶可讀取/寫入自己的資料
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ============ 班級廚房主文件 ============
    match /kitchens/{classId} {
      // 公開讀取（顧客選擇班級用）
      allow read: if true;
      // 登入管理員可更新（owner 或 classAdmin）
      allow write: if isClassAdminOf(classId);
    }

    // ============ 班級廚房 - 菜單 ============
    match /kitchens/{classId}/menuItems/{itemId} {
      // 公開讀取（顧客看菜單）
      allow read: if true;
      // 管理員可完整 CRUD
      allow create, delete: if isClassAdminOf(classId);
      // 管理員或任何人可更新庫存
      allow update: if isClassAdminOf(classId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']);
    }

    // ============ 班級廚房 - 訂單 ============
    match /kitchens/{classId}/orders/{orderId} {
      // 公開建立（顧客下單）和讀取（查看狀態）
      allow create, read: if true;
      // 管理員可更新/刪除
      allow update, delete: if isClassAdminOf(classId);
    }

    // ============ 班級廚房 - 每日銷售統計 ============
    match /kitchens/{classId}/dailySales/{date} {
      allow read, write: if true;
    }

    // ============ 班級廚房 - 訂單計數器 ============
    match /kitchens/{classId}/orderCounts/{date} {
      allow read, write: if true;
    }

    // ============ 班級廚房 - 系統設定 ============
    match /kitchens/{classId}/system/{docId} {
      // 公開讀取（顧客知道是否營業中）
      allow read: if true;
      // 管理員可修改
      allow write: if isClassAdminOf(classId);
    }

    // ============ 頂層集合（向下相容） ============

    match /menuItems/{itemId} {
      allow read: if true;
      allow update: if isSignedIn() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']);
      allow create, delete: if isSignedIn();
    }

    match /orders/{orderId} {
      allow create, read: if true;
      allow update, delete: if isSignedIn();
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /dailySales/{date} {
      allow read, write: if true;
    }

    match /orderCounts/{date} {
      allow read, write: if true;
    }
  }
}
